---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Comments from '../../components/Comments.astro'
import { excerpt, fmtDate, getPosts, langOf, linkedPosts, tagSlug, type Post } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }))
}

const { post, all } = Astro.props as { post: Post; all: Post[] }
const { Content, headings } = await render(post)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const linked = linkedPosts(post, all)
const lang = langOf(post)
---

<Base title={post.data.title} description={excerpt(post, 160)} lang={lang}>
  <div class="wrap">
    <Header />
    <div class="columns">
      <article class="main">
        <header class="head">
          <div class="mono meta">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmtDate(post.data.date)}</time>
            {post.data.tags.map((t) => <a href={`/tags/${tagSlug(t)}`}>#{tagSlug(t)}</a>)}
          </div>
          <h1>{post.data.title}</h1>
        </header>
        <div class="prose">
          <Content />
        </div>
        <Comments lang={lang} />
      </article>
      {
        (toc.length > 0 || linked.length > 0) && (
          <aside class="side toc">
            {toc.length > 0 && (
              <nav aria-label="목차">
                <div class="label">On this page</div>
                {toc.map((h) => (
                  <a href={`#${h.slug}`} class:list={{ sub: h.depth === 3 }}>
                    {h.text}
                  </a>
                ))}
              </nav>
            )}
            {linked.length > 0 && (
              <nav aria-label="연결된 글">
                <div class="label">Linked</div>
                {linked.map((p) => (
                  <a href={`/blog/${p.id}`}>{p.data.title}</a>
                ))}
              </nav>
            )}
          </aside>
        )
      }
    </div>
  </div>
</Base>

<style>
  .wrap { display: flex; flex-direction: column; gap: 48px; }
  .main { max-width: 680px; }
  .head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 36px; }
  .meta { display: flex; flex-wrap: wrap; gap: 12px; font-size: 13px; color: var(--faint); }
  .meta a { color: var(--accent); }
  h1 { margin: 0; font-size: 36px; font-weight: 600; line-height: 1.3; color: var(--text-strong); }
  .toc { display: flex; flex-direction: column; gap: 28px; align-self: flex-start; position: sticky; top: 32px; }
  .toc nav { display: flex; flex-direction: column; gap: 10px; }
  .toc a { font-size: 14px; line-height: 1.5; color: var(--muted); }
  .toc a.sub { padding-left: 12px; font-size: 13px; }
  .toc a:hover { color: var(--accent); }
  @media (max-width: 900px) {
    .toc { position: static; }
    h1 { font-size: 30px; }
  }
</style>
